# ==============================================================================
# BANCO DE DADOS POSTGRESQL (NEON)
# ==============================================================================
# DATABASE_URL: String com pooling de conexões (usada pela aplicação e pelo Prisma Client)
DATABASE_URL="postgresql://usuario:senha@ep-exemplo-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# DIRECT_URL: String de conexão direta sem pooler (usada pelo Prisma Migrate para DDL)
DIRECT_URL="postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/neondb?sslmode=require"

# ==============================================================================
# AUTENTICAÇÃO E SEGURANÇA
# ==============================================================================
# Chave secreta para assinatura de tokens JWT nos cookies HttpOnly (insira uma chave forte e aleatória em produção)
JWT_SECRET="coloque_uma_chave_secreta_jwt_longa_e_segura_aqui"

# ==============================================================================
# ARMAZENAMENTO DE IMAGENS (VERCEL BLOB)
# ==============================================================================
# Token de leitura/escrita obtido na Vercel (Storage -> Vercel Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_token_exemplo"

# ==============================================================================
# CREDENCIAIS PADRÃO DE TESTE (CRIADAS NO SEED)
# ==============================================================================
ADMIN_WHATSAPP="17999990000"
ADMIN_PASSWORD="admin_comitiva"
ADMIN_NAME="Administrador Comitiva"

TEST_CLIENT_WHATSAPP="17998124421"
TEST_CLIENT_PASSWORD="cliente_comitiva"
TEST_CLIENT_NAME="Tiago Silveira"

# ==============================================================================
# URL BASE DA APLICAÇÃO (OPCIONAL)
# ==============================================================================
NEXT_PUBLIC_APP_URL="http://localhost:3000"
